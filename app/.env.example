VITE_DEMO_MODE=false

# F-28 Nível 2, Fase 2 (CS-01) — Google Cloud OAuth2 credentials ("Web application" client type).
# Leave both empty to keep Google Drive sync hidden in Settings.
# Google's token endpoint requires client_secret even with PKCE for this client type — see
# clientSecret() in src/lib/cloudSync/googleAuth.ts for why bundling it client-side is fine here.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
